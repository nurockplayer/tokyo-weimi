{
  "name": "tokyo-weimi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsx tools/postbuild.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx tools/check-site.ts && tsx --test tests/profile-identity.spec.ts && tsx tools/test-content-contract-failures.ts && tsx tools/check-content-contract.ts",
    "attendance:update": "tsx tools/update-today-attendance.ts",
    "lint": "biome lint src tools tests",
    "lint:check-config": "tsx tools/check-lint-config.ts",
    "typecheck": "tsc --noEmit",
    "content:check-store": "tsx tools/check-content-store.ts",
    "content:check-contract": "tsx tools/check-content-contract.ts",
    "content:check-contract-failures": "tsx tools/test-content-contract-failures.ts",
    "content:check-persist": "tsx tools/check-persist-refresh-result.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  }
}