{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnreachable": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noFallthroughSwitchClause": "error"
      }
    }
  }
}
